{% block fk_faq_tag_detail %}
<sw-page class="fk-faq-tag-detail">

    {% block fk_faq_tag_detail_header %}
    <template #smart-bar-header>
        <h2 v-if="tag">
            {{ tag.name || $t('fk-faq-tag.detail.textHeadlineNew') }}
        </h2>
    </template>
    {% endblock %}

    {% block fk_faq_tag_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block fk_faq_tag_detail_actions %}
    <template #smart-bar-actions>
        <mt-button
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>

        <sw-button-process
            variant="primary"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            :disabled="isLoading"
            @process-finish="saveFinish"
            @click="onSave"
        >
            {{ $t('global.default.save') }}
        </sw-button-process>
    </template>
    {% endblock %}

    <template #content>
        {% block fk_faq_tag_detail_content %}
        <sw-card-view>
            <sw-skeleton v-if="isLoading" />

            <mt-card
                v-else-if="tag"
                position-identifier="fk-faq-tag-detail-base"
                :title="$t('fk-faq-tag.detail.cardTitleBase')"
            >
                <mt-text-field
                    v-model="tag.name"
                    required
                    :label="$t('fk-faq-tag.detail.labelName')"
                    :placeholder="$t('fk-faq-tag.detail.placeholderName')"
                />
            </mt-card>
        </sw-card-view>
        {% endblock %}
    </template>

</sw-page>
{% endblock %}
