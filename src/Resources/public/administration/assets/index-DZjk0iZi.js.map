{% block sw_cms_block_fk_faq_preview %}
<div class="sw-cms-preview-fk-faq">
    <div class="sw-cms-preview-fk-faq__row is--open">
        <span class="sw-cms-preview-fk-faq__bar"></span>
        <span class="sw-cms-preview-fk-faq__sign">&minus;</span>
    </div>
    <div class="sw-cms-preview-fk-faq__answer"></div>
    <div class="sw-cms-preview-fk-faq__row">
        <span class="sw-cms-preview-fk-faq__bar"></span>
        <span class="sw-cms-preview-fk-faq__sign">+</span>
    </div>
    <div class="sw-cms-preview-fk-faq__row">
        <span class="sw-cms-preview-fk-faq__bar"></span>
        <span class="sw-cms-preview-fk-faq__sign">+</span>
    </div>
</div>
{% endblock %}
