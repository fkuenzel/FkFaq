{% sw_extends '@Storefront/storefront/element/cms-element-product-description-reviews.html.twig' %}

{#
    Ergaenzt den Beschreibungs- und Bewertungsbereich um einen FAQ-Reiter.
    Greift nur, wenn in der Plugin-Konfiguration "Als separater Reiter"
    eingestellt ist; die Alternative haengt unter der Beschreibung und liegt
    in component/product/description.html.twig.
#}

{% block element_product_description_reviews_tabs_navigation_review %}
    {{ parent() }}

    {% set fkFaqExtension = page.extensions.fkFaq|default(null) %}

    {% if fkFaqExtension and fkFaqExtension.hasFaqs and fkFaqExtension.isTab %}
        {% set fkFaqTabId = 'fk-faq-tab-' ~ element.data.product.id %}

        {% block fk_faq_tab_navigation %}
            <li class="nav-item">
                <a class="nav-link product-detail-tab-navigation-link fk-faq-tab"
                   id="{{ fkFaqTabId }}"
                   data-bs-toggle="tab"
                   data-off-canvas-tabs="true"
                   href="#{{ fkFaqTabId }}-pane"
                   role="tab"
                   aria-controls="{{ fkFaqTabId }}-pane"
                   aria-selected="false">
                    <span>{{ 'fkFaq.detail.tabTitle'|trans|sw_sanitize }}</span>
                    <span class="product-detail-tab-navigation-icon">
                        {% sw_icon 'arrow-medium-right' style {'pack':'solid'} %}
                    </span>
                </a>
            </li>
        {% endblock %}
    {% endif %}
{% endblock %}

{% block element_product_description_reviews_tabs_content_review %}
    {{ parent() }}

    {% set fkFaqExtension = page.extensions.fkFaq|default(null) %}

    {% if fkFaqExtension and fkFaqExtension.hasFaqs and fkFaqExtension.isTab %}
        {% set fkFaqTabId = 'fk-faq-tab-' ~ element.data.product.id %}

        {% block fk_faq_tab_content %}
            <div class="tab-pane fade show fk-faq-tab-pane"
                 id="{{ fkFaqTabId }}-pane"
                 role="tabpanel"
                 aria-labelledby="{{ fkFaqTabId }}">
                {% sw_include '@FkFaq/storefront/component/fk-faq/faq-accordion.html.twig' with {
                    faqs: fkFaqExtension.faqs,
                    idPrefix: 'tab-' ~ element.data.product.id,
                    showTitle: true
                } %}
            </div>
        {% endblock %}
    {% endif %}
{% endblock %}
